{% extends "base.html.twig" %}

{% block title %}{{ 'Pokemon Database'|trans }}{% endblock %}

{% block content %}
<div class="container">
    <h1 class="text-center mb-4">{{ 'Pokédex'|trans }}</h1>
    
    <div class="row row-cols-1 row-cols-md-3 row-cols-lg-4 g-4">
        {% for pokemon in pokemons %}
            <div class="col">
                <div class="card h-100 shadow-sm">
                    <img src="/images/{{ pokemon.ImagePath }}" class="card-img-top p-3" alt="{{ pokemon.Name }}" style="height: 200px; object-fit: contain;">
                    <div class="card-body">
                        <h5 class="card-title text-capitalize">{{ pokemon.Number ~ '# ' ~ pokemon.Name }}</h5>
                        <div class="d-flex gap-2 flex-wrap">
                            {% for tipo in pokemon.tipos %}
                                <span class="badge rounded-pill type-badge {{ typeColors[tipo]|default('bg-secondary') }}">
                                    {{ tipo }}
                                </span>
                            {% endfor %}
                        </div>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
</div>
{% endblock %}

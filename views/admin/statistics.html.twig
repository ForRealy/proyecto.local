{% extends "base.html.twig" %}

{% block title %}{{ 'Pokemon Statistics'|trans }}{% endblock %}

{% block stylesheets %}
{{ parent() }}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/chart.js@3.7.0/dist/chart.min.css">
{% endblock %}

{% block content %}
<div class="container mt-4">
    <h1 class="mb-4">{{ 'Pokemon Statistics'|trans }}</h1>
    
    <div class="row">
        <div class="col-md-6">
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="card-title">{{ 'Type Distribution'|trans }}</h5>
                </div>
                <div class="card-body">
                    <canvas id="typeChart"></canvas>
                </div>
            </div>
        </div>
        
        <div class="col-md-6">
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="card-title">{{ 'Pokemon by Generation'|trans }}</h5>
                </div>
                <div class="card-body">
                    <canvas id="generationChart"></canvas>
                </div>
            </div>
        </div>
    </div>
    
    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title">{{ 'Type Combinations'|trans }}</h5>
                </div>
                <div class="card-body">
                    <canvas id="combinationChart"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

{% block javascripts %}
{{ parent() }}
<script src="https://cdn.jsdelivr.net/npm/chart.js@3.7.0/dist/chart.min.js"></script>
<script>
// Fetch statistics data
async function fetchStatistics() {
    const response = await fetch('/api/statistics');
    return await response.json();
}

// Initialize charts
async function initializeCharts() {
    const data = await fetchStatistics();
    
    // Type Distribution Chart
    new Chart(document.getElementById('typeChart'), {
        type: 'pie',
        data: {
            labels: data.typeDistribution.map(item => item.type),
            datasets: [{
                data: data.typeDistribution.map(item => item.count),
                backgroundColor: [
                    '#FF6384', '#36A2EB', '#FFCE56', '#4BC0C0', '#9966FF',
                    '#FF9F40', '#FF6384', '#36A2EB', '#FFCE56', '#4BC0C0',
                    '#9966FF', '#FF9F40', '#FF6384', '#36A2EB', '#FFCE56',
                    '#4BC0C0', '#9966FF', '#FF9F40'
                ]
            }]
        },
        options: {
            responsive: true,
            plugins: {
                legend: {
                    position: 'right'
                }
            }
        }
    });
    
    // Generation Chart
    new Chart(document.getElementById('generationChart'), {
        type: 'bar',
        data: {
            labels: data.generationDistribution.map(item => item.generation),
            datasets: [{
                label: '{{ "Number of Pokemon"|trans }}',
                data: data.generationDistribution.map(item => item.count),
                backgroundColor: '#36A2EB'
            }]
        },
        options: {
            responsive: true,
            scales: {
                y: {
                    beginAtZero: true,
                    ticks: {
                        stepSize: 1
                    }
                }
            }
        }
    });
    
    // Type Combination Chart
    new Chart(document.getElementById('combinationChart'), {
        type: 'bar',
        data: {
            labels: data.typeCombinations.map(item => item.combination),
            datasets: [{
                label: '{{ "Number of Pokemon"|trans }}',
                data: data.typeCombinations.map(item => item.count),
                backgroundColor: '#4BC0C0'
            }]
        },
        options: {
            responsive: true,
            indexAxis: 'y',
            scales: {
                x: {
                    beginAtZero: true,
                    ticks: {
                        stepSize: 1
                    }
                }
            }
        }
    });
}

// Initialize charts when the page loads
document.addEventListener('DOMContentLoaded', initializeCharts);
</script>
{% endblock %}
{% endblock %} 
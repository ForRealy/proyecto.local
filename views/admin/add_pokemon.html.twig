{% extends "base.html.twig" %}

{% block title %}{{ 'Add Pokemon'|trans }}{% endblock %}

{% block content %}
<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header">
                    <h3 class="card-title mb-0">{{ 'Add Pokemon'|trans }}</h3>
                </div>
                <div class="card-body">
                    {% if error %}
                        <div class="alert alert-danger">{{ error }}</div>
                    {% endif %}

                    <form method="POST" action="/admin/pokemon/add">
                        <div class="mb-3">
                            <label for="number" class="form-label">{{ 'Number'|trans }}</label>
                            <input type="number" class="form-control" id="number" name="number" required min="1">
                            <small class="text-muted">{{ 'Enter the Pokemon number'|trans }}</small>
                        </div>

                        <div class="mb-3">
                            <label for="name" class="form-label">{{ 'Name'|trans }}</label>
                            <input type="text" class="form-control" id="name" name="name" required>
                            <small class="text-muted">{{ 'Enter the Pokemon name'|trans }}</small>
                        </div>

                        <div class="mb-3">
                            <label for="imagePath" class="form-label">{{ 'Image Path'|trans }}</label>
                            <input type="text" class="form-control" id="imagePath" name="imagePath" required>
                            <small class="text-muted">{{ 'Enter the filename of the image (e.g., bulbasaur.png)'|trans }}</small>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a href="/admin/dashboard" class="btn btn-secondary">
                                <i class="fas fa-arrow-left"></i> {{ 'Back to Dashboard'|trans }}
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-plus"></i> {{ 'Add Pokemon'|trans }}
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %} 